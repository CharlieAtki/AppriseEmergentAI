# Copy this file to .env and fill in real values.
# docker-compose reads .env automatically.

# ── Postgres ────────────────────────────────────────────────────────────────── #
POSTGRES_DB=apprise
POSTGRES_USER=apprise
POSTGRES_PASSWORD=apprise

# ── LLM backend ─────────────────────────────────────────────────────────────── #
# anthropic | bedrock | local
LLM_BACKEND=anthropic
FAST_MODEL=claude-haiku-4-5-20251001
STRONG_MODEL=claude-sonnet-4-5

# Required when LLM_BACKEND=anthropic
ANTHROPIC__API_KEY=sk-ant-...

# Required when LLM_BACKEND=bedrock
# AWS_REGION=eu-west-2
# FAST_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
# STRONG_MODEL=anthropic.claude-sonnet-4-5-v1:0

# Set to true to skip all LLM calls — pure structural testing only
FORCE_HEURISTIC_FALLBACK=false

# ── Vector store ─────────────────────────────────────────────────────────────── #
# qdrant is used for both local and production
VECTOR_BACKEND=qdrant

# ── Clerk auth ───────────────────────────────────────────────────────────────── #
# Required for human user login (machine clients use X-API-Key)
# CLERK_SECRET_KEY=sk_...
