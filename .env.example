# Copy this file to .env and fill in real values.
# docker-compose reads .env automatically.
# For running services directly on the host (outside Docker), see backend/.env

# ── Postgres ─────────────────────────────────────────────────────────────────── #
POSTGRES_DB=apprise
POSTGRES_USER=apprise
POSTGRES_PASSWORD=apprise

# ── Anthropic ────────────────────────────────────────────────────────────────── #
# Required when using the Anthropic vendor (default)
ANTHROPIC__API_KEY=sk-ant-...

# ── Intelligence ─────────────────────────────────────────────────────────────── #
# Set to true to skip all LLM calls — structural testing only
INTELLIGENCE__FORCE_HEURISTIC_FALLBACK=false

# ── Clerk auth ───────────────────────────────────────────────────────────────── #
# Required for human user JWT login (machine clients use X-API-Key)
# CLERK__SECRET_KEY=sk_...       ← backend SDK (double underscore, Pydantic prefix)
# CLERK_PUBLISHABLE_KEY=pk_test_ ← frontend SDK (single underscore, @clerk/nextjs)
