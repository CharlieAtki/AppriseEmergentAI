# .env.example — reference template with no real values.
#
# With Doppler (recommended):
#   doppler run -- docker compose up
#   No .env file needed — Doppler injects all variables at runtime.
#   See docs/deployment.md for Doppler setup instructions.
#
# Without Doppler (fallback):
#   cp .env.example .env && fill in real values

# ── Postgres ─────────────────────────────────────────────────────────────── #
POSTGRES_DB=apprise
POSTGRES_USER=apprise
POSTGRES_PASSWORD=

# ── Anthropic ─────────────────────────────────────────────────────────────── #
ANTHROPIC__API_KEY=

# ── Intelligence ──────────────────────────────────────────────────────────── #
# Set to true to skip all LLM calls — structural testing only
INTELLIGENCE__FORCE_HEURISTIC_FALLBACK=false

# ── Coordination ──────────────────────────────────────────────────────────── #
# Platform defaults for ContractNet coordination guards — org/workspace can
# override within the ceiling; see core/coordination/config.py.
COORDINATION__MAX_DELEGATION_DEPTH_DEFAULT=3
COORDINATION__MAX_DELEGATION_DEPTH_CEILING=5
COORDINATION__DECOMPOSE_DIFFICULTY_THRESHOLD_DEFAULT=4.0

# ── Clerk auth ────────────────────────────────────────────────────────────── #
# Publishable key — browser-safe, used by @clerk/nextjs on the frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key — stored once; docker-compose maps it to CLERK_SECRET_KEY for the frontend
# (single-underscore expected by @clerk/nextjs) and CLERK__SECRET_KEY for the backend
# (double-underscore expected by pydantic-settings nested config)
CLERK__SECRET_KEY=
# Svix signing secret: Clerk dashboard → Webhooks → your endpoint → Signing Secret
CLERK__WEBHOOK_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────── #
# Comma-separated allowed browser origins.
# Leave unset in production if CORS is handled at the reverse proxy / edge layer.
CORS_ORIGINS=http://localhost:3000

# ── Centrifugo (live dashboard WebSocket) ──────────────────────────────────── #
# Origin(s) Centrifugo allows WebSocket connections from — set to your actual
# frontend origin(s) in production.
CENTRIFUGO_ALLOWED_ORIGIN=http://localhost:3000
# HTTP API key Centrifugo requires on POST /api/publish — worker-only, the API
# process never publishes.
CENTRIFUGO__HTTP_API_KEY=
# Shared secret Centrifugo attaches to its connect/subscribe proxy callbacks
# into the API process — api-only, the worker never receives proxy callbacks.
CENTRIFUGO__PROXY_SECRET=
